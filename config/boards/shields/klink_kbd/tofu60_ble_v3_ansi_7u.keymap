#include "common.keymap"

#define UF_RESET bootloader_reset 0 0
#define UF_BT1 device_bt1 0 0
#define UF_BT2 device_bt2 0 1
#define UF_BT3 device_bt3 0 2

/ {
    macros {
        macro_corp: macro_corp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp C &kp O &kp R &kp P &kp BSLH &kp K &kp Y &kp N9 &kp N1 &kp DOT &kp H &kp A &kp I>;
        };
        macro_pass91: macro_pass91 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LS(H) &kp A &kp I &kp K &kp Y &kp N9 &kp N1 &kp N &kp A &kp LS(N1)>;
        };
        macro_pass90: macro_pass90 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LS(H) &kp A &kp I &kp K &kp Y &kp N9 &kp N9 &kp N0 &kp N &kp A &kp LS(N1)>;
        };
        macro_username: macro_username {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp K &kp Y &kp N9 &kp N1 &kp DOT &kp H &kp A &kp I>;
        };
        macro_genid: macro_genid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp N1 &kp N5 &kp N7 &kp N9 &kp N8 &kp N6 &kp N7 &kp N5>;
        };
        macro_passlogin: macro_passlogin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp N2 &kp N9 &kp N0 &kp N8 &kp N9 &kp N1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        
        default_layer {

            bindings = <
    &gresc  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSLH  &kp DELETE
    &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp BSPC
    &kp LCTRL    &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT        &kp RET
    &kp LSHFT      &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH      &kp RSHIFT &mo 1
    &trans &kp LGUI &kp LALT             &kp SPACE                       &kp RALT  &kp LC(LA(DEL))    &trans
            >;
        };

        layer1 {
            bindings = <
    &trans  &kp F1    &kp F2    &kp F3      &kp F4   &kp F5   &kp F6   &kp F7  &kp F8   &kp F9    &kp F10   &kp F11       &kp F12        &UF_RESET &kp INSERT
    &trans  &trans    &kp UP    &Device_USB &UF_BT1  &UF_BT2  &UF_BT3  &trans  &trans   &trans    &kp UP    &kp PAGE_UP   &kp PAGE_DOWN  &macro_genid 
    &trans  &kp LEFT  &kp DOWN  &kp RIGHT   &trans   &trans   &trans   &trans  &trans   &kp LEFT  &kp DOWN  &kp RIGHT     &trans 
    &macro_username  &trans    &trans    &trans      &trans   &trans   &trans   &trans  &trans   &trans    &kp LG(L)    &macro_passlogin        &trans
    &trans  &macro_pass91    &macro_pass90                            &trans                                    &kp CLCK  &macro_corp        &trans
            >;
        };
        layer2 { status = "reserved"; };
        layer3 { status = "reserved"; };
        layer4 { status = "reserved"; };
        layer5 { status = "reserved"; };
        layer6 { status = "reserved"; };
        layer7 { status = "reserved"; };
    };
};
